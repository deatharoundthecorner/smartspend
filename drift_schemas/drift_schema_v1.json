        }
      ]
    },
    {
      "name": "receipt_attachments",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"receipt_attachments\" (\"id\" TEXT NOT NULL PRIMARY KEY, \"local_path\" TEXT NOT NULL, \"verified_at\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "expenses",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"expenses\" (\"id\" TEXT NOT NULL PRIMARY KEY, \"submission_id\" TEXT NOT NULL UNIQUE, \"submission_fingerprint\" TEXT NOT NULL, \"amount_minor\" INTEGER NOT NULL CHECK (typeof(amount_minor) = 'integer' AND amount_minor > 0), \"currency_code\" TEXT NOT NULL DEFAULT 'LKR' CHECK (currency_code = 'LKR'), \"category_id\" TEXT NOT NULL REFERENCES categories(id)ON DELETE RESTRICT, \"merchant_name\" TEXT NOT NULL DEFAULT '' CHECK (length(merchant_name) <= 160), \"note\" TEXT NOT NULL DEFAULT '' CHECK (length(note) <= 2000), \"spent_at\" INTEGER NOT NULL, \"source\" TEXT NOT NULL CHECK (source IN ('manual', 'receipt')), \"receipt_attachment_id\" TEXT REFERENCES receipt_attachments(id)ON DELETE RESTRICT, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER, CHECK(source != 'receipt' OR receipt_attachment_id IS NOT NULL));"
        }
      ]
    },
    {
      "name": "expenses_date",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX expenses_date ON expenses (spent_at) WHERE deleted_at IS NULL"
        }
      ]
    },
    {
      "name": "expenses_category_date",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX expenses_category_date ON expenses (category_id, spent_at) WHERE deleted_at IS NULL"
        }
      ]
    },
    {
      "name": "budgets",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"budgets\" (\"id\" TEXT NOT NULL PRIMARY KEY, \"month\" TEXT NOT NULL CHECK (length(month) = 7), \"category_id\" TEXT REFERENCES categories(id)ON DELETE RESTRICT, \"amount_minor\" INTEGER NOT NULL CHECK (typeof(amount_minor) = 'integer' AND amount_minor > 0), \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "budgets_scope",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE UNIQUE INDEX budgets_scope ON budgets (month, ifnull(category_id, ''))"
        }
      ]
    },
    {
